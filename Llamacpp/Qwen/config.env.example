# Copy this file to config.env on DGX Spark and edit it there.

# Model identity.
MODEL_FAMILY=qwen
MODEL_DISPLAY_NAME="Qwen llama.cpp SQL tuner"
SERVED_MODEL_NAME=qwen-sql-tuner

# Official Qwen 3.6 27B BF16 Hugging Face repository.
MODEL_REPO=Qwen/Qwen3.6-27B
MODEL_REVISION=main
HF_GGUF_MODEL_REF=unsloth/Qwen3.6-27B-GGUF:BF16

# Local runtime directories. These are ignored by git.
WORK_DIR=runtime
LLAMA_CPP_DIR=runtime/llama.cpp
HF_MODEL_DIR=runtime/models/qwen-hf
GGUF_MODEL=runtime/models/qwen-27b-bf16.gguf

# llama.cpp source.
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp.git
LLAMA_CPP_REF=b15ca938ad00aa6b3ee6c2edda7363fd02826b18

# Build/runtime precision.
GGUF_OUTTYPE=bf16
# f16 is the no-KV-quantization default. For memory-pressure tests, try:
# KV_CACHE_TYPE_K=f16
# KV_CACHE_TYPE_V=q8_0
KV_CACHE_TYPE=f16
KV_CACHE_TYPE_K=f16
KV_CACHE_TYPE_V=f16

# Server settings.
HOST=127.0.0.1
BIND_ADDRESS=127.0.0.1
PORT=8080
# Qwen3.6-27B natively supports 262,144 tokens. Use 128K on one DGX Spark
# as the quality-first AutorunEnum working context.
CTX_SIZE=131072
N_GPU_LAYERS=999
PARALLEL=1
BATCH_SIZE=2048
UBATCH_SIZE=512
THREADS=16
FLASH_ATTN=1
# Keep reasoning unrestricted and return it separately from the final JSON.
LLAMA_SERVER_EXTRA_ARGS="--metrics --reasoning on --reasoning-budget -1 --reasoning-format deepseek"

# Official Qwen 3.6 27B Thinking sampling profile. Seed is fixed so repeated
# SQL-tuning runs can be compared under the same sampling sequence.
TEMPERATURE=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0
REPETITION_PENALTY=1.0
SEED=42

# Set to 1 if you want run_all.sh to install apt packages.
INSTALL_SYSTEM_PACKAGES=0

# Set to 0 if you want run_all.sh to build/download/convert only.
START_SERVER=1

# Docker settings.
CONTAINER_WORKDIR=/workspace/llamacpp
DOCKER_IMAGE=llamacpp-qwen-server:cuda
DOCKER_CONTAINER=llamacpp-qwen-server
DOCKER_HF_CACHE_VOLUME=llamacpp-qwen-huggingface-cache
DOCKER_CUDA_IMAGE=nvcr.io/nvidia/cuda:13.0.1-devel-ubuntu24.04
