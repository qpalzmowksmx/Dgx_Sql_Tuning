+	type PerformanceStats = {
+		promptTokens: number | null;
+		completionTokens: number | null;
+		totalTokens: number | null;
+		promptRate: number | null;
+		completionRate: number | null;
+		contextLimit: number | null;
+	};
+
+	const firstFiniteNumber = (...values: unknown[]): number | null => {
+		for (const value of values) {
+			const parsed = typeof value === 'string' && value.trim() !== '' ? Number(value) : value;
+			if (typeof parsed === 'number' && Number.isFinite(parsed)) {
+				return parsed;
+			}
+		}
+		return null;
+	};
+
+	const buildPerformanceStats = (
+		usage: Record<string, unknown> | undefined,
+		model: any
+	): PerformanceStats | null => {
+		if (!usage) return null;
+
+		const promptTokens = firstFiniteNumber(
+			usage.input_tokens,
+			usage.prompt_tokens,
+			usage.prompt_eval_count,
+			usage.prompt_n
+		);
+		const completionTokens = firstFiniteNumber(
+			usage.output_tokens,
+			usage.completion_tokens,
+			usage.eval_count,
+			usage.predicted_n
+		);
+		const totalTokens = firstFiniteNumber(
+			usage.total_tokens,
+			promptTokens !== null && completionTokens !== null
+				? promptTokens + completionTokens
+				: null
+		);
+
+		const promptDuration = firstFiniteNumber(usage.prompt_eval_duration);
+		const completionDuration = firstFiniteNumber(usage.eval_duration);
+		const promptRate = firstFiniteNumber(
+			usage.prompt_per_second,
+			usage['prompt_token/s'],
+			promptTokens !== null && promptDuration !== null && promptDuration > 0
+				? promptTokens / (promptDuration / 1_000_000_000)
+				: null
+		);
+		const completionRate = firstFiniteNumber(
+			usage.predicted_per_second,
+			usage['response_token/s'],
+			completionTokens !== null && completionDuration !== null && completionDuration > 0
+				? completionTokens / (completionDuration / 1_000_000_000)
+				: null
+		);
 
+		const contextLimit = firstFiniteNumber(
+			model?.n_ctx,
+			model?.meta?.n_ctx,
+			model?.details?.n_ctx,
+			model?.openai?.n_ctx,
+			model?.openai?.meta?.n_ctx,
+			model?.info?.meta?.n_ctx,
+			model?.info?.meta?.details?.n_ctx
+		);
+
+		return { promptTokens, completionTokens, totalTokens, promptRate, completionRate, contextLimit };
+	};
+
+	const formatTokens = (value: number) => Math.round(value).toLocaleString();
+	const formatRate = (value: number) => value.toFixed(1);
+
+	$: performanceStats = buildPerformanceStats(message?.usage, model);
