# DeepSeek V4 Flash UD-IQ3_XXS optimized fork for one 128 GB DGX Spark.

# Experimental llama.cpp fork, pinned to the requested optimization commit.
LLAMA_CPP_REPO=https://github.com/satindergrewal/llama.cpp.git
LLAMA_CPP_BRANCH=deepseek-v4-flash
LLAMA_CPP_REF=7a02824e968f2ce85ad919169962e0020595d141
LLAMA_CPP_PRE_CUDA_REF=6652af2cb162936806e5ac47438c006937156b3f
LLAMA_CPP_BASE_REF=8f114a9b573b69035299f9b924047f53c1e22c7e

# DGX Spark GB10 is ARM64 Blackwell SM121. CUDA 13 is required for this target.
CUDA_ARCHITECTURES=121
GGML_CUDA_FA_ALL_QUANTS=1
GGML_NATIVE=1
CUDA_IMAGE=nvcr.io/nvidia/cuda:13.0.1-devel-ubuntu24.04

# llama.cpp downloads the sharded GGUF into LLAMA_CACHE on first use.
HF_GGUF_MODEL_REF=unsloth/DeepSeek-V4-Flash-GGUF:UD-IQ3_XXS
# Optional local-shard mode. The Compose bind mount exposes LOCAL_GGUF_DIR as
# /models; when GGUF_MODEL is non-empty it takes precedence over -hf.
LOCAL_GGUF_DIR=
GGUF_MODEL=
MODEL_DISPLAY_NAME="DeepSeek V4 Flash UD-IQ3_XXS DGX Spark optimized fork"
SERVED_MODEL_NAME=deepseek-v4-flash-iq3-xxs
WORK_DIR=runtime
LLAMA_CPP_DIR=runtime/llama.cpp
MODEL_CACHE_DIR=runtime/llama-cache

# DGX Spark has coherent 128 GB unified memory. Do not use --cpu-moe; let the
# CUDA backend place the model as one device and keep an 8 GiB runtime margin.
N_GPU_LAYERS=auto
SPLIT_MODE=none
MAIN_GPU=0
FIT=1
FIT_TARGET_MIB=8192
FIT_MIN_CTX=65536

# 103 GB-class IQ3 weights leave limited runtime headroom on 128 GB unified RAM.
CTX_SIZE=65536
KV_CACHE_TYPE_K=q8_0
KV_CACHE_TYPE_V=q8_0
PARALLEL=1
BATCH_SIZE=1024
UBATCH_SIZE=256
THREADS=16
THREADS_BATCH=20
FLASH_ATTN=on
# llama.cpp's DGX Spark benchmark uses --no-mmap. The benchmark matrix also
# measures mmap=1 before this default is treated as final for this model.
USE_MMAP=0
DIRECT_IO=0

# SQL tuning profile validated against the local five-query MySQL grader.
# top-k/min-p and penalties stay disabled so the server does not narrow it.
TEMPERATURE=0.20
TOP_P=1.0
TOP_K=0
MIN_P=0.0
PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0
REPETITION_PENALTY=1.0
SEED=42

# Use managed allocation on DGX Spark. Setting this to 0 makes the wrapper
# actually unset the presence-based llama.cpp environment variable.
GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
# Keep the upstream offload threshold as the serving default. The benchmark
# matrix measures 32 against 1 because this setting changes the global policy.
GGML_OP_OFFLOAD_MIN_BATCH=32

HOST=127.0.0.1
BIND_ADDRESS=127.0.0.1
PORT=8080
LLAMA_SERVER_EXTRA_ARGS="--metrics --perf --jinja"

# Capacity and hardware guardrails.
MIN_SYSTEM_MEMORY_GIB=115
MIN_FREE_DISK_GIB=140
SKIP_PREFLIGHT=0
ALLOW_UNSUPPORTED_HARDWARE=0
GPU_NAME_PATTERN=GB10

# Paired generation benchmark. The depth curve follows llama.cpp's DGX Spark
# benchmark and exposes whether selected compressed-key gather scales.
BENCH_PROMPT_TOKENS=512
BENCH_GENERATION_TOKENS=64
BENCH_DEPTH=0,4096,8192,16384,32768
BENCH_REPETITIONS=3
BENCH_OUTPUT_FORMAT=md
BENCH_RESULTS_DIR=logs/benchmarks

# Docker names are separate from the stable DeepSeek and DwarfStar services.
DOCKER_IMAGE=llm-sql-dsv4-iq3xxs-dgx-spark:cuda13
DOCKER_CONTAINER=llm-sql-dsv4-iq3xxs-dgx-spark
DOCKER_MODEL_CACHE_VOLUME=llm-sql-dsv4-iq3xxs-dgx-spark-cache
RESTART_POLICY=unless-stopped

# Optional for gated/rate-limited Hugging Face access. Never commit a token.
HF_TOKEN=
