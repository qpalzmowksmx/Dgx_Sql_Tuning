# DeepSeek V4 Flash 0731 UD-IQ3_XXS for one 128 GB NVIDIA DGX Spark.

LLAMA_CPP_REPO=https://github.com/satindergrewal/llama.cpp.git
LLAMA_CPP_BRANCH=deepseek-v4-flash
LLAMA_CPP_REF=7a02824e968f2ce85ad919169962e0020595d141
CUDA_IMAGE=nvcr.io/nvidia/cuda:13.0.1-devel-ubuntu24.04
CUDA_ARCHITECTURES=121a-real
GGML_CUDA_FA_ALL_QUANTS=1
GGML_NATIVE=1

# Closed-network model layout. Copy every UD-IQ3_XXS shard into this folder.
LOCAL_GGUF_RELATIVE_DIR=runtime/local-gguf
LOCAL_GGUF_DIR=
GGUF_MODEL=
OFFLINE_MODEL_REQUIRED=1
EXPECTED_MODEL_MARKER=UD-IQ3_XXS
HF_GGUF_MODEL_REF=unsloth/DeepSeek-V4-Flash-0731-GGUF:UD-IQ3_XXS

MODEL_DISPLAY_NAME="DeepSeek V4 Flash 0731 UD-IQ3_XXS"
SERVED_MODEL_NAME=deepseek-v4-flash-0731-iq3-xxs
MODEL_CACHE_DIR=runtime/llama-cache

# Request 64K first. The pinned llama.cpp --fit implementation may reduce the
# context to 32K if the model, KV cache and runtime do not fit together.
CTX_SIZE=65536
FIT=1
FIT_TARGET_MIB=6144
FIT_MIN_CTX=32768
KV_CACHE_TYPE_K=q8_0
KV_CACHE_TYPE_V=q8_0
N_GPU_LAYERS=auto
SPLIT_MODE=none
MAIN_GPU=0
PARALLEL=1
BATCH_SIZE=512
UBATCH_SIZE=128
THREADS=16
THREADS_BATCH=20
FLASH_ATTN=on
USE_MMAP=0
DIRECT_IO=0

# DeepSeek V4 Flash 0731 Code Agent recommendation. Request payload values sent
# by a client may override these server defaults.
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=0
MIN_P=0.0
PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0
REPETITION_PENALTY=1.0
SEED=42
THINKING_MODE=thinking
REASONING_EFFORT=max
MAX_TOKENS=16384

GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
GGML_OP_OFFLOAD_MIN_BATCH=32
HOST=127.0.0.1
BIND_ADDRESS=127.0.0.1
PORT=8080
LLAMA_SERVER_EXTRA_ARGS="--metrics --perf --jinja"

DOCKER_IMAGE=llm-sql-dsv4-0731-iq3xxs-dgx-spark:cuda13
LEGACY_DOCKER_IMAGE=llm-sql-dsv4-0731-iq3s-dgx-spark:cuda13
DOCKER_CONTAINER=llm-sql-dsv4-0731-iq3xxs-dgx-spark
DOCKER_MODEL_CACHE_VOLUME=llm-sql-dsv4-0731-iq3xxs-dgx-spark-cache
DOCKER_HF_CACHE_VOLUME=llm-sql-dsv4-0731-iq3xxs-dgx-spark-hf-cache
RESTART_POLICY=unless-stopped
SHM_SIZE=16gb

OPEN_WEBUI_IMAGE=llm-sql-open-webui:v0.9.4-dgx-stats
OPEN_WEBUI_CONTAINER=deepseek-v4-flash-0731-iq3xxs-open-webui
OPEN_WEBUI_DATA_VOLUME=deepseek-v4-flash-0731-iq3xxs-general-webui-data
OPEN_WEBUI_NAME="DeepSeek V4 Flash 0731 UD-IQ3_XXS"
OPEN_WEBUI_BIND_ADDRESS=127.0.0.1
OPEN_WEBUI_PORT=3000
BUILD_ON_START=0
MODEL_HEALTH_TIMEOUT_SEC=7200
OPEN_WEBUI_HEALTH_TIMEOUT_SEC=900

# Optional online fallback only. Keep blank for the closed network.
HF_TOKEN=
