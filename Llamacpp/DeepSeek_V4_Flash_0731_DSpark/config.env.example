# DeepSeek V4 Flash 0731 on one 128 GB DGX Spark.
# This stack is dedicated to general LLM chat through Open WebUI.

CUDA_IMAGE=nvcr.io/nvidia/cuda:13.0.1-devel-ubuntu24.04
BUILD_JOBS=8
DS4_AUTO_BUILD=1

# Source revision, model filenames, greedy mode, and image tag are pinned in
# runtime.env. Keep personal access tokens only in config.env.
HF_TOKEN=

SERVED_MODEL_NAME=deepseek-v4-flash-0731-dspark
MODEL_DISPLAY_NAME="DeepSeek V4 Flash 0731 DSpark Chat"
CTX_SIZE=32768
DEFAULT_MAX_TOKENS=16384
THREADS=16
GPU_VRAM=
PREFILL_CHUNK=2048
SSD_STREAMING=1
SSD_STREAMING_CACHE_EXPERTS=48GB

# The current mixed base GGUF plus support GGUF exceeds the stable resident
# memory budget of a single 128 GB Spark. Keep DSpark off and use DS4 SSD
# streaming. Re-enable only after moving to a proven smaller matched pair or a
# larger/multi-node target.
DS4_ENABLE_DSPARK=0
DSPARK_CONFIDENCE=0.7

# Keep the normal DS4 path. QUALITY_MODE is a slower diagnostic-quality mode.
WARM_WEIGHTS=0

# Reuse long chat/system-prefix KV state without carrying hidden conversation
# state between requests. API requests remain stateless.
KV_DISK_SPACE_MB=8192
KV_CACHE_MIN_TOKENS=512
KV_CACHE_COLD_MAX_TOKENS=30000
KV_CACHE_CONTINUED_INTERVAL_TOKENS=10000

HOST=0.0.0.0
BIND_ADDRESS=127.0.0.1
PORT=8080
ENABLE_CORS=1

DOCKER_CONTAINER=deepseek-v4-flash-0731-dspark-server
DOCKER_KV_VOLUME=deepseek-v4-flash-0731-dspark-chat-kv
RESTART_POLICY=unless-stopped
MODEL_HEALTH_TIMEOUT_SEC=7200

OPEN_WEBUI_IMAGE=llm-sql-open-webui:v0.9.4-dgx-stats
OPEN_WEBUI_CONTAINER=deepseek-v4-flash-0731-dspark-open-webui
OPEN_WEBUI_DATA_VOLUME=deepseek-v4-flash-0731-dspark-general-webui-data
OPEN_WEBUI_NAME="DeepSeek V4 Flash 0731 DSpark Chat"
OPEN_WEBUI_BIND_ADDRESS=127.0.0.1
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_HEALTH_TIMEOUT_SEC=900
