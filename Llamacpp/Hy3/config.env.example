# Hy3 IQ1_M + MTP for one 128 GB NVIDIA DGX Spark.

# Use the exact base and two patches shipped by this GGUF repository. Upstream
# PR #25395 has base/MTP support, but this patch set also adds the Hy3-specific
# thinking/tool-call response parser.
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp.git
LLAMA_CPP_BRANCH=master
LLAMA_CPP_REF=19bba67c1f4db723c60a0d421aa0788bf4ddc699
HY3_PATCH_BASE_URL=https://huggingface.co/AngelSlim/Hy3-GGUF/raw/218c93f0fb5227553b67e556b01dfe70fb70cf30/patches
HY3_PATCH_01_FILE=01-hyv3-arch.patch
HY3_PATCH_01_SHA256=23d9def340b452a4bad4900ed20f81d6fdfaf2954b91eae30cf1a0dd0daa21ca
HY3_PATCH_02_FILE=02-hyv3-mtp-tools.patch
HY3_PATCH_02_SHA256=51dea330aa41548d13c21535a7e5e0227f9ae3a182fc5e3cc241adee5ed8b0f7

# DGX Spark GB10 is ARM64 Blackwell SM121 and requires CUDA 13. NVIDIA's
# recommended CMake target is 121-real when compiling directly for Spark.
CUDA_ARCHITECTURES=121-real
GGML_CUDA_FA_ALL_QUANTS=1
GGML_NATIVE=1
CUDA_IMAGE=nvcr.io/nvidia/cuda:13.0.1-devel-ubuntu24.04

# Exact file requested from the Hugging Face repository. The revision, byte
# count and SHA-256 are pinned to the metadata observed on 2026-07-14.
MODEL_REPO=AngelSlim/Hy3-GGUF
MODEL_REVISION=218c93f0fb5227553b67e556b01dfe70fb70cf30
MODEL_FILE=Hy3-IQ1_M-mtp.gguf
MODEL_SIZE_BYTES=91756066624
MODEL_SHA256=f3b9ab6394d9de03394b9d95aa75af42ca7025711cf8418857eddd0d213e5f13
MODEL_DISPLAY_NAME="Hy3 295B-A21B IQ1_M MTP"
SERVED_MODEL_NAME=hy3-iq1-m-mtp
WORK_DIR=runtime
LLAMA_CPP_DIR=runtime/llama.cpp
MODEL_DIR=runtime/models

# DGX Spark has 128 GB coherent unified memory. Keep the whole model on its one
# CUDA device. --fit may shrink context down to FIT_MIN_CTX if startup is tight.
N_GPU_LAYERS=auto
SPLIT_MODE=none
MAIN_GPU=0
FIT=1
FIT_TARGET_MIB=8192
FIT_MIN_CTX=16384

# The requested file is about 85.46 GiB including its MTP head. A 64K q8_0
# main/draft KV cache is a conservative starting point on 128 GB unified RAM.
CTX_SIZE=65536
KV_CACHE_TYPE_K=q8_0
KV_CACHE_TYPE_V=q8_0
KV_CACHE_TYPE_K_DRAFT=q8_0
KV_CACHE_TYPE_V_DRAFT=q8_0
PARALLEL=1
BATCH_SIZE=1024
UBATCH_SIZE=256
THREADS=16
THREADS_BATCH=20
FLASH_ATTN=on
USE_MMAP=0
DIRECT_IO=0

# Hy3 has one MTP layer. The upstream validation found p-min 0.75 important;
# p-min 0 made this model slower even though speculative decoding still worked.
ENABLE_MTP=1
SPEC_DRAFT_N_MAX=3
SPEC_DRAFT_N_MIN=1
SPEC_DRAFT_P_MIN=0.75

# Official Hy3 sampling defaults. Individual API requests can override these.
TEMPERATURE=0.9
TOP_P=1.0
TOP_K=0
MIN_P=0.0
PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0
REPETITION_PENALTY=1.0
SEED=42

GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
GGML_OP_OFFLOAD_MIN_BATCH=32

HOST=127.0.0.1
BIND_ADDRESS=127.0.0.1
PORT=8080
LLAMA_SERVER_EXTRA_ARGS="--metrics --perf --jinja"

# Hardware and capacity guardrails. MIN_RECLAIMABLE_MEMORY_GIB checks current
# MemAvailable + SwapFree, not only the installed 128 GB memory class. The first
# download needs 85.46 GiB plus build/image and partial-download headroom;
# subsequent runs only require the remaining download plus the post-download
# reserve.
MIN_SYSTEM_MEMORY_GIB=115
MIN_RECLAIMABLE_MEMORY_GIB=100
MIN_FREE_DISK_GIB=125
MIN_POST_DOWNLOAD_FREE_GIB=25
SKIP_PREFLIGHT=0
ALLOW_UNSUPPORTED_HARDWARE=0
GPU_NAME_PATTERN=GB10

DOCKER_IMAGE=llm-sql-hy3-iq1m-mtp-dgx-spark:cuda13
DOCKER_CONTAINER=llm-sql-hy3-iq1m-mtp-dgx-spark
DOCKER_MODEL_VOLUME=llm-sql-hy3-iq1m-mtp-model
RESTART_POLICY=unless-stopped

# Optional for rate-limited Hugging Face access. Never commit a token.
HF_TOKEN=
