# Overrides layered after config.env by Reasoning-start.sh.
# Existing config.env remains the common hardware/model configuration.
REASONING_EFFORT=high
# Reuse the already exported Hy3 runtime image. The reasoning entrypoint is
# selected by Reasoning-docker-compose.yml, so no second image is required.
DOCKER_IMAGE=llm-sql-hy3-iq1m-mtp-dgx-spark:cuda13
DOCKER_CONTAINER=llm-sql-hy3-iq1m-mtp-reasoning-high
